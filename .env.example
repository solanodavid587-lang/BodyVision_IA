# Solo para desarrollo local. No usar estas credenciales en staging ni producción.
POSTGRES_DB=bodyvision
POSTGRES_USER=bodyvision
POSTGRES_PASSWORD=bodyvision_local_only

# Mantener sincronizadas las credenciales de PostgreSQL y la URL de conexión.
DATABASE_URL=postgresql+psycopg://bodyvision:bodyvision_local_only@db:5432/bodyvision
CORS_ORIGINS=http://localhost:5173

# Solo para levantar un administrador local en el primer arranque.
# Cambiar estos valores; no usar credenciales de ejemplo fuera del entorno local.
AUTH_SECRET_KEY=local-only-change-this-secret-before-deploy-32chars
ENVIRONMENT=development
SESSION_COOKIE_SECURE=false
INITIAL_ADMIN_DNI=12345678
INITIAL_ADMIN_PASSWORD=ChangeMe_LocalOnly_2026!
INITIAL_ADMIN_NAME=Administración BODYVISION
